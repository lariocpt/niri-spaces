#!/usr/bin/env bash
# niri-spaces — declarative workspace layout manager for niri.
#
#   niri-spaces load <name> [args...]   load spaces/<name>.space (or templates/<name>.space with $1..$9 substituted)
#   niri-spaces start                   run every `load ...` line in ~/.config/niri-spaces/autostart
#   niri-spaces menu                    pick a space interactively (fuzzel if available, else terminal)
#   niri-spaces list                    list available spaces and templates
#   niri-spaces terminal-pairs [--check] run the optional 50/50 terminal watcher
#   niri-spaces workspace-colors [--check] run the optional per-workspace color scheme watcher
#
# Space files live in ~/.config/niri-spaces/spaces/ and templates/.
#
# Layout file format (.space) — parsing ported from niri-wspaces-loader:
#   @workspace <name-or-index>
#   <app_id> | <launch command> [| <env vars> [| <capture var>]]
#   @action <shell command>            # may use captured window-id vars
# Lines starting with # and blank lines are ignored.
set -uo pipefail

CONFIG_DIR="${NIRI_SPACES_DIR:-$HOME/.config/niri-spaces}"

# The test suite sources this file to exercise single functions (resolve_defaults and
# friends) without launching anything. Under sourcing, none of the script's top-level
# side effects belong to the caller: no help, no dependency check, no dispatch, and no
# exit that would kill the shell doing the sourcing. Executed as a program, $0 is this
# file, and everything below runs as normal.
ns_sourced=1
[ "${BASH_SOURCE[0]:-$0}" = "$0" ] && ns_sourced=0

# Answered before anything else, dependency check included. Usage text that first demands
# niri and jq cannot be read on the machine where you are still working out what to install
# -- and it silently handed the page gate an empty --help, which then blamed the page.
if [ "$ns_sourced" -eq 0 ]; then
    case "${1:-}" in
        -h|--help|"") awk 'NR==1{next} /^#/{sub(/^#[[:space:]]?/,"");print;next} {exit}' "$0"; exit 0 ;;
    esac
fi

# jq is not optional: launch_on_workspace diffs `niri msg --json windows` before and after
# each spawn to learn the new window id. Without it that diff silently yields nothing, every
# app hits the 10-second "no new window appeared" timeout, and @action lines that reference a
# captured id get an empty value. The failure looks like niri being slow rather than a missing
# dependency, so say so up front.
#
# It comes from packages.txt on a post-install machine; anywhere else it is one package.
if [ "$ns_sourced" -eq 0 ]; then
    for _dep in jq niri; do
        command -v "$_dep" >/dev/null 2>&1 || {
            printf 'niri-spaces: %s is required but not on PATH\n' "$_dep" >&2
            exit 1
        }
    done
    unset _dep
fi

# First command in the list that actually exists on this machine.
pick_first() {
    local c
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# The app_id a given launch command reports to the compositor. Matching in
# launch_on_workspace is a prefix match, so a bare family name is enough.
app_id_for() {
    case "$(basename "${1%% *}")" in
        ghostty)                        printf 'com.mitchellh.ghostty' ;;
        alacritty)                      printf 'Alacritty' ;;
        wezterm|wezterm-gui)            printf 'org.wezfurlong.wezterm' ;;
        foot|footclient)                printf 'foot' ;;
        brave*)                         printf 'brave' ;;
        google-chrome*)                 printf 'google-chrome' ;;
        firefox*)                       printf 'firefox' ;;
        *)                              printf '%s' "$(basename "${1%% *}")" ;;
    esac
}

# Portable defaults so the shipped spaces work on any machine. Anything already
# exported wins — set TERMINAL/BROWSER yourself to override the autodetection.
#
# The terminal candidates are limited to emulators that accept `--title=X -e CMD`,
# because spaces/main.space uses exactly that to run zenith. wezterm (`start --`)
# and xterm (`-title`) do not, so they are not autodetected — app_id_for still
# maps wezterm for anyone who exports TERMINAL=wezterm deliberately, but then
# main.space's zenith line is on them.
resolve_defaults() {
    : "${TERMINAL:=$(pick_first ghostty foot alacritty kitty)}"
    : "${BROWSER:=$(pick_first brave-origin brave firefox google-chrome chromium)}"
    [ -n "${TERMINAL:-}" ] || echo "warning: no terminal found (set \$TERMINAL)" >&2
    [ -n "${BROWSER:-}" ]  || echo "warning: no browser found (set \$BROWSER)" >&2
    : "${TERMINAL_APPID:=$(app_id_for "${TERMINAL:-}")}"
    : "${BROWSER_APPID:=$(app_id_for "${BROWSER:-}")}"
    export TERMINAL BROWSER TERMINAL_APPID BROWSER_APPID
}

trim() {
    local var="$*"
    var="${var#"${var%%[![:space:]]*}"}"
    var="${var%"${var##*[![:space:]]}"}"
    printf '%s' "$var"
}

wait_for_niri() {
    for _ in {1..30}; do
        niri msg workspaces >/dev/null 2>&1 && return 0
        sleep 0.2
    done
    echo "Error: niri is not running or not responding." >&2
    return 1
}

# Spawn a command, watch for a new window with the given app_id, move it to the
# target workspace. Echoes the new window id on success.
launch_on_workspace() {
    local target_ws="$1"
    local app_id="$2"
    shift 2
    local cmd=("$@")

    # Prefix match so e.g. "brave" covers brave-browser and brave-browser-nightly.
    # The $app inside is a jq variable handed to `jq --arg`, not a shell expansion,
    # so the single quotes are deliberate — silence the shell-expansion lint.
    # shellcheck disable=SC2016
    local jq_filter='.[] | select(.app_id != null) | select(.app_id | startswith($app)) | .id'
    local pre_ids
    pre_ids=$(niri msg --json windows | jq -r --arg app "$app_id" "$jq_filter")

    setsid "${cmd[@]}" >/dev/null 2>&1 </dev/null &

    for _ in {1..50}; do
        local post_ids new_id
        post_ids=$(niri msg --json windows | jq -r --arg app "$app_id" "$jq_filter")
        new_id=$(comm -13 <(echo "$pre_ids" | sort) <(echo "$post_ids" | sort) | head -n 1)
        if [ -n "$new_id" ] && [ "$new_id" != "null" ]; then
            niri msg action move-window-to-workspace --window-id "$new_id" "$target_ws" >/dev/null 2>&1
            echo "$new_id"
            return 0
        fi
        sleep 0.2
    done
    echo "warning: no new '$app_id' window appeared within 10s (window left where it opened)" >&2
    return 1
}

# Parse and execute one .space file (already template-substituted if needed).
run_space_file() {
    local ws_file="$1"
    local current_ws=""
    local line app_id cmd env_vars var_name win_id action_cmd
    local lineno=0

    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        line=$(trim "$line")
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue

        if [[ "$line" =~ ^@workspace[[:space:]]+(.*) ]]; then
            current_ws="${BASH_REMATCH[1]}"
            echo "-> workspace: $current_ws"
            continue
        elif [[ "$line" =~ ^@action[[:space:]]+(.*) ]]; then
            action_cmd="${BASH_REMATCH[1]}"
            eval "$action_cmd" || echo "warning: @action failed: $action_cmd" >&2
            continue
        elif [[ "$line" == @* ]]; then
            echo "warning: unknown directive '${line%%[[:space:]]*}' at ${ws_file}:${lineno} (ignored)" >&2
            continue
        fi

        IFS='|' read -r app_id cmd env_vars var_name <<< "$line"
        app_id=$(trim "${app_id:-}")
        # The command field is eval'd below, so it expands $VARS for free; the
        # app_id field is used as a literal, so expand it here too. Lets a space
        # file say `$TERMINAL_APPID | $TERMINAL` and stay machine-agnostic.
        case "$app_id" in *'$'*) app_id=$(eval "printf '%s' \"$app_id\"") ;; esac
        cmd=$(trim "${cmd:-}")
        env_vars=$(trim "${env_vars:-}")
        var_name=$(trim "${var_name:-}")
        { [ -z "$app_id" ] || [ -z "$cmd" ]; } && continue
        if [ -n "$var_name" ]; then
            eval "$var_name=\"\""
        fi

        echo "   launching $app_id: $cmd"
        win_id=""
        if [ -n "$env_vars" ]; then
            win_id=$(eval "export $env_vars; launch_on_workspace \"\$current_ws\" \"\$app_id\" $cmd") || true
        else
            win_id=$(eval "launch_on_workspace \"\$current_ws\" \"\$app_id\" $cmd") || true
        fi
        if [ -n "$var_name" ] && [ -n "$win_id" ]; then
            eval "$var_name=\"$win_id\""
        fi
    done < "$ws_file"
}

# Resolve a space name to a file; substitute $1..$9 for templates.
# Prints the path of a ready-to-run file (may be a temp file).
resolve_space() {
    local name="$1"; shift
    if [ -f "$CONFIG_DIR/spaces/$name.space" ]; then
        printf '%s\n' "$CONFIG_DIR/spaces/$name.space"
        return 0
    fi
    if [ -f "$CONFIG_DIR/templates/$name.space" ]; then
        local tmp i
        tmp=$(mktemp --suffix=".space")
        cp "$CONFIG_DIR/templates/$name.space" "$tmp"
        for i in $(seq 1 $#); do
            sed -i "s/\$$i/$(printf '%s' "${!i}" | sed 's/[&/\]/\\&/g')/g" "$tmp"
        done
        printf '%s\n' "$tmp"
        return 0
    fi
    echo "Error: no space or template named '$name' in $CONFIG_DIR" >&2
    return 1
}

cmd_load() {
    [ $# -ge 1 ] || { echo "usage: niri-spaces load <name> [args...]" >&2; return 1; }
    local name="$1"; shift
    wait_for_niri || return 1
    resolve_defaults
    local file
    file=$(resolve_space "$name" "$@") || return 1
    echo "Loading space '$name' ..."
    run_space_file "$file"
    case "$file" in /tmp/*) rm -f "$file" ;; esac
    echo "Space '$name' loaded."
}

cmd_start() {
    local autostart="$CONFIG_DIR/autostart"
    [ -f "$autostart" ] || { echo "No autostart file at $autostart — nothing to do."; return 0; }
    wait_for_niri || return 1
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(trim "$line")
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue
        if [[ "$line" =~ ^load[[:space:]]+(.*) ]]; then
            # shellcheck disable=SC2086
            cmd_load ${BASH_REMATCH[1]}
        else
            echo "warning: unrecognized autostart line: $line" >&2
        fi
    done < "$autostart"
    # Start after loading layouts: the watcher treats the resulting windows as
    # an existing snapshot and never rearranges them. Disabled by default.
    local helper
    helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/niri-terminal-pairs"
    if [ -x "$helper" ]; then
        niri msg action spawn -- "$helper" >/dev/null 2>&1 || return 1
    fi
    # Same for workspace colors: the helper reads settings.json itself and exits
    # quietly when the feature is off, so it is safe to start unconditionally.
    helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/niri-workspace-colors"
    if [ -x "$helper" ]; then
        niri msg action spawn -- "$helper" >/dev/null 2>&1 || return 1
    fi
    # Land on the first workspace when done.
    niri msg action focus-workspace 1 >/dev/null 2>&1 || true
}

cmd_list() {
    local f
    echo "Spaces ($CONFIG_DIR/spaces):"
    for f in "$CONFIG_DIR"/spaces/*.space; do [ -f "$f" ] && echo "  $(basename "$f" .space)"; done
    echo "Templates ($CONFIG_DIR/templates) — need args:"
    for f in "$CONFIG_DIR"/templates/*.space; do [ -f "$f" ] && echo "  $(basename "$f" .space)"; done
    return 0
}

cmd_menu() {
    local names=() f pick
    for f in "$CONFIG_DIR"/spaces/*.space; do [ -f "$f" ] && names+=("$(basename "$f" .space)"); done
    [ ${#names[@]} -gt 0 ] || { echo "No spaces defined in $CONFIG_DIR/spaces." >&2; return 1; }
    if command -v fuzzel >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        pick=$(printf '%s\n' "${names[@]}" | fuzzel --dmenu --prompt "niri-space> ") || return 0
    else
        echo "Select a space to load:"
        select pick in "${names[@]}"; do [ -n "$pick" ] && break; done
    fi
    [ -n "$pick" ] && cmd_load "$pick"
}

# Dispatch is the program's entry point, so it is the one thing a sourcing shell must
# not run: with no guard, `source niri-spaces` reached the unknown-subcommand arm and
# exited the test's own shell.
if [ "$ns_sourced" -eq 0 ]; then
    case "${1:-}" in
        load)  shift; cmd_load "$@" ;;
        start) cmd_start ;;
        list)  cmd_list ;;
        terminal-pairs)
            shift
            exec "$(dirname "$(readlink -f "$0")")/niri-terminal-pairs" "$@"
            ;;
        workspace-colors)
            shift
            exec "$(dirname "$(readlink -f "$0")")/niri-workspace-colors" "$@"
            ;;
        menu)  cmd_menu ;;
        # -h/--help/"" never reach here: answered above the dependency preflight, so
        # help does not require the tools it is there to tell you about.
        *) echo "unknown subcommand: $1 (try: load, start, menu, list, terminal-pairs, workspace-colors)" >&2; exit 1 ;;
    esac
fi
