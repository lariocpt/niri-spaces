#!/usr/bin/env bash
# Fake `niri` for the bats suite. It is a controllable stand-in for the real
# compositor client, and it is the ONLY thing faked: the CLI hard-requires jq,
# so the tests run with the real jq driving the real window-diff against the
# state this stub serves. See the state model at the bottom of this file.
#
# Contract the tests rely on:
#   $NIRI_FAKE_STATE    a JSON array file = the current window list.
#                       `niri msg --json windows` prints exactly this file.
#   $NIRI_FAKE_WORKSPACES  a JSON array file = the current workspace list.
#                       `niri msg --json workspaces` prints exactly this file.
#                       Three actions mutate it like the real compositor:
#                       new-workspace appends a fresh slot, move-window-to-
#                       workspace to an index past the end appends the slot
#                       that receives the window, and set-workspace-name
#                       stamps the name onto the workspace at that index.
#   $NIRI_FAKE_ACTIONS  an append-only log. Every `niri msg action ...` (and any
#                       other msg subcommand) is written here so tests can assert
#                       the action sequence the CLI emitted.
#
# `niri msg workspaces` is the CLI's health probe (wait_for_niri polls it). It is
# answered with success and NOT logged, so the actions log holds only real
# actions — otherwise a single health line would front-run every sequence assert.
set -eu

state=${NIRI_FAKE_STATE:?fake niri: NIRI_FAKE_STATE not set}
actions=${NIRI_FAKE_ACTIONS:?fake niri: NIRI_FAKE_ACTIONS not set}

# Top-level form we model is `niri msg ...`; anything else is logged verbatim.
if [ "${1:-}" != "msg" ]; then
    printf 'niri %s\n' "$*" >>"$actions"
    exit 0
fi
shift

# `msg --json windows` -> serve the live window list (real jq reads this file).
if [ "${1:-}" = "--json" ] && [ "${2:-}" = "windows" ]; then
    if [ -s "$state" ]; then
        cat "$state"
    else
        printf '[]\n'
    fi
    exit 0
fi

# `msg --json workspaces` -> serve the live workspace list. Same idea as the
# window list: $NIRI_FAKE_WORKSPACES is a JSON array file the test writes (or
# the new-workspace rule below appends to); absent means "no workspaces".
if [ "${1:-}" = "--json" ] && [ "${2:-}" = "workspaces" ]; then
    if [ -n "${NIRI_FAKE_WORKSPACES:-}" ] && [ -s "$NIRI_FAKE_WORKSPACES" ]; then
        cat "$NIRI_FAKE_WORKSPACES"
    else
        printf '[]\n'
    fi
    exit 0
fi

# `msg action new-workspace ...` -> log it, then materialise the slot the real
# compositor would create: a fresh id above every seen id, appended at the
# end. This is what makes the CLI's "create a workspace" round-trip (action,
# then re-query) observable in a test.
if [ "${1:-}" = "action" ] && [ "${2:-}" = "new-workspace" ]; then
    printf 'niri msg %s\n' "$*" >>"$actions"
    if [ -n "${NIRI_FAKE_WORKSPACES:-}" ]; then
        # NB: the bound expression must be parenthesised — jq 1.7 parses
        # `X + 1 as $id | …' as `X + (1 as $id | …)', which errors, while jq
        # 1.8 binds the sum. Parens parse identically on both.
        jq '(((map(.id) | max) // 0) + 1) as $id
            | (((map(.idx) | max) // 0) + 1) as $idx
            | . + [{id: $id, idx: $idx, name: null, output: "eDP-1",
                    is_urgent: false, is_active: false, is_focused: false,
                    active_window_id: null}]' \
            "$NIRI_FAKE_WORKSPACES" >"$NIRI_FAKE_WORKSPACES.new"
        mv "$NIRI_FAKE_WORKSPACES.new" "$NIRI_FAKE_WORKSPACES"
    fi
    exit 0
fi

# `msg --json outputs` -> the monitor list. A read-only query like windows:
# served from $NIRI_FAKE_OUTPUTS when the test writes one, empty otherwise,
# and never logged (the actions log holds only real actions).
if [ "${1:-}" = "--json" ] && [ "${2:-}" = "outputs" ]; then
    if [ -n "${NIRI_FAKE_OUTPUTS:-}" ] && [ -s "$NIRI_FAKE_OUTPUTS" ]; then
        cat "$NIRI_FAKE_OUTPUTS"
    else
        printf '[]\n'
    fi
    exit 0
fi

# `msg --json event-stream` -> no events and immediate EOF: the daemons read
# the empty stream as "compositor gone" and take their exit path, which is
# exactly what the session-snapshot specs want to drive. Not logged.
if [ "${1:-}" = "--json" ] && [ "${2:-}" = "event-stream" ]; then
    exit 0
fi

# `msg workspaces` -> the readiness probe. Succeed, do not pollute the log.
if [ "${1:-}" = "workspaces" ]; then
    exit 0
fi

# `msg action set-workspace-name NAME --workspace IDX` -> log it, then stamp
# the name onto the workspace at that index, as the real compositor does. This
# is what lets a test see the CLI's create-then-name round trip take effect.
if [ "${1:-}" = "action" ] && [ "${2:-}" = "set-workspace-name" ]; then
    printf 'niri msg %s\n' "$*" >>"$actions"
    if [ -n "${NIRI_FAKE_WORKSPACES:-}" ] && [ -s "$NIRI_FAKE_WORKSPACES" ]; then
        jq --argjson i "$5" --arg n "$3" 'map(if .idx == $i then .name = $n else . end)' \
            "$NIRI_FAKE_WORKSPACES" >"$NIRI_FAKE_WORKSPACES.new"
        mv "$NIRI_FAKE_WORKSPACES.new" "$NIRI_FAKE_WORKSPACES"
    fi
    exit 0
fi

# `msg action move-window-to-workspace --window-id ID TARGET` -> log it. When
# TARGET is a number past the end of the list, niri opens one unnamed slot at
# that index to receive the window (26.04 behaviour the CLI's create path
# depends on), so the stub appends exactly that slot. Either way the target
# workspace then reports the window as its active one, which is what makes a
# workspace "busy" to the CLI's resolver. A by-name target is the same stamp
# on the workspace bearing that name.
if [ "${1:-}" = "action" ] && [ "${2:-}" = "move-window-to-workspace" ]; then
    printf 'niri msg %s\n' "$*" >>"$actions"
    win=${*: -2:1}
    target=${*: -1}
    if [ -n "${NIRI_FAKE_WORKSPACES:-}" ]; then
        count=$(jq 'length' "${NIRI_FAKE_WORKSPACES:-/dev/null}" 2>/dev/null || echo 0)
        if [[ "$target" =~ ^[0-9]+$ ]] && [ "$target" -gt "$count" ]; then
            jq '(((map(.id) | max) // 0) + 1) as $id
                | . + [{id: $id, idx: '"$target"', name: null, output: "eDP-1",
                        is_urgent: false, is_active: false, is_focused: false,
                        active_window_id: null}]' \
                "$NIRI_FAKE_WORKSPACES" >"$NIRI_FAKE_WORKSPACES.new"
            mv "$NIRI_FAKE_WORKSPACES.new" "$NIRI_FAKE_WORKSPACES"
        fi
        if [[ "$target" =~ ^[0-9]+$ ]]; then
            jq --argjson i "$target" --arg w "$win" \
                'map(if .idx == $i then .active_window_id = $w else . end)' \
                "$NIRI_FAKE_WORKSPACES" >"$NIRI_FAKE_WORKSPACES.new"
        else
            jq --arg n "$target" --arg w "$win" \
                'map(if .name == $n then .active_window_id = $w else . end)' \
                "$NIRI_FAKE_WORKSPACES" >"$NIRI_FAKE_WORKSPACES.new"
        fi
        mv "$NIRI_FAKE_WORKSPACES.new" "$NIRI_FAKE_WORKSPACES"
    fi
    exit 0
fi

# Everything else (the real actions) is recorded for assertions.
printf 'niri msg %s\n' "$*" >>"$actions"
exit 0

# ---------------------------------------------------------------- state model
# state.json is a flat JSON array of {"id": <str>, "app_id": <str>}. The fake
# apps (winapp) append to it; launch_on_workspace reads it before/after each
# spawn and diffs the ids whose app_id startswith() the target app to learn the
# new window. This stub only ever serves it verbatim — jq does all manipulation.
