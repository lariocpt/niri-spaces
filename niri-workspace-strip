#!/usr/bin/env python3
"""Show every niri workspace as a numbered chip the user can drag to reorder.

One strip per display: niri numbers workspaces per monitor, so each output
gets its own row of chips sitting on that screen (the strips follow a monitor
in and out — when a screen is unplugged its workspaces collapse onto the
remaining one and only that strip remains). A chip carries the background and
accent of the color scheme its workspace bears (the same schemes
niri-workspace-colors assigns and the same state file it keeps), so a
workspace keeps its color for its whole life — including when it is dragged.

The strip reserves space like a bar (its height plus margin form an exclusive
zone on the anchored edge), so it never covers a bar or a window. By default
it sits at the top, centered, directly below whatever already occupies the
top edge; workspace_strip_position (top|bottom), workspace_strip_align
(left|center|right) and workspace_strip_margin place it elsewhere.

Dragging chip i to a gap position j performs exactly one niri reorder action
on that monitor's list:

    niri msg action move-workspace-to-index <j> --reference <i>

While dragging, the source chip lifts out of the row and the row opens a gap
at the pointer — the gap's slot is where the workspace lands. Niri reorders
the list (the other workspaces shift) and the workspace's name — which is its
color scheme — travels with it, so the color is preserved by construction.
A plain click focuses that monitor and then the workspace.

  niri-workspace-strip                    run the strips (settings must enable them)
  niri-workspace-strip --check            validate settings; no writes, no IPC
  niri-workspace-strip status             report the live chips per monitor
  niri-workspace-strip reorder FROM TO [OUTPUT]
                                          move the workspace displayed as FROM to
                                          TO on OUTPUT (default: FROM's monitor)

FROM and TO are the 1-based indexes niri displays on that monitor — the same
numbers the chips show. The daemon needs python3-gi with GTK 3 and
gtk-layer-shell, and a Niri session (XDG_RUNTIME_DIR, NIRI_SOCKET,
WAYLAND_DISPLAY).
"""
import argparse
import fcntl
import json
import os
import runpy
import signal
import subprocess
import sys
from pathlib import Path

LOCK_NAME = "niri-workspace-strip.lock"
COLOR_STATE_NAME = "workspace-colors.json"
DEFAULT_HEIGHT = 30
CHIP_WIDTH = 44  # one chip's width in logical px (the surface is n of these)
GAP_EXTRA = 10   # extra px the drag gap adds, so the insertion point is visible
MIN_HEIGHT = 16
MAX_HEIGHT = 128
DEFAULT_MARGIN = 0
MAX_MARGIN = 512
DEFAULT_POSITION = "top"
POSITIONS = ("top", "bottom")
DEFAULT_ALIGN = "center"
ALIGNS = ("left", "center", "right")

# Neutral colors for a chip whose workspace bears no scheme (a machine-theme
# workspace). Kept deliberately close to the dark estate themes so an unnamed
# chip reads as "no color assigned" rather than as a scheme of its own.
PLAIN_BACKGROUND = "#1e232a"
PLAIN_FOREGROUND = "#c9d1d9"
PLAIN_ACCENT = "#7d8590"
DRAG_FOREGROUND = "#0b0e12"


def log(message):
    print(f"workspace strip: {message}", file=sys.stderr, flush=True)


def config_dir():
    return Path(os.environ.get("NIRI_SPACES_DIR", Path.home() / ".config/niri-spaces"))


def builtin_schemes():
    """The classic palette, read from the color watcher next to this file so
    the two tools can never drift apart. Empty when the helper is absent
    (this file installed alone) — settings may still provide schemes.
    run_path (not an import) because the helper has no .py extension; its
    run_name is '<run_path>', so the helper's main() guard cannot fire."""
    sibling = Path(__file__).resolve().parent / "niri-workspace-colors"
    if not sibling.is_file():
        return []
    try:
        module = runpy.run_path(str(sibling))
        # The color daemon assigns from the full pool (SCHEMES + EXTRA_SCHEMES);
        # reading only the classic list left every extra scheme (indigo,
        # cappuccino, ...) uncolored in the chips.
        pool = list(module["SCHEMES"]) + list(module.get("EXTRA_SCHEMES", []))
        return [dict(s) for s in pool]
    except (OSError, AttributeError, ValueError, ImportError):
        return []


def settings():
    """(enabled, height, position, align, margin): where and how the strips
    sit. position is the anchored edge ("top" or "bottom"), align places the
    row on that edge ("left", "center" or "right"), and margin is the gap in
    px between the screen edge / an already-docked bar and the strip. The
    strip always reserves its own space (an exclusive zone), so it never
    overlaps a bar. workspace_strip_margin_top is accepted as the old name
    of workspace_strip_margin."""
    path = config_dir() / "settings.json"
    config = json.loads(path.read_text()) if path.exists() else {}
    enabled = config.get("workspace_strip", False)
    if not isinstance(enabled, bool):
        raise ValueError("workspace_strip must be true or false")
    height = config.get("workspace_strip_height", DEFAULT_HEIGHT)
    if isinstance(height, bool) or not isinstance(height, int):
        raise ValueError("workspace_strip_height must be an integer")
    if not MIN_HEIGHT <= height <= MAX_HEIGHT:
        raise ValueError(f"workspace_strip_height must be between {MIN_HEIGHT} and {MAX_HEIGHT}")
    position = config.get("workspace_strip_position", DEFAULT_POSITION)
    if position not in POSITIONS:
        raise ValueError(f"workspace_strip_position must be one of {', '.join(POSITIONS)}")
    align = config.get("workspace_strip_align", DEFAULT_ALIGN)
    if align not in ALIGNS:
        raise ValueError(f"workspace_strip_align must be one of {', '.join(ALIGNS)}")
    if "workspace_strip_margin" in config:
        margin = config["workspace_strip_margin"]
    else:
        margin = config.get("workspace_strip_margin_top", DEFAULT_MARGIN)
    if isinstance(margin, bool) or not isinstance(margin, int):
        raise ValueError("workspace_strip_margin must be an integer")
    if not 0 <= margin <= MAX_MARGIN:
        raise ValueError(f"workspace_strip_margin must be between 0 and {MAX_MARGIN}")
    return enabled, height, position, align, margin


def normalize(scheme):
    filled = dict(scheme)
    for key in ("background", "ring_active", "ring_inactive", "border",
                "shadow", "tab_active", "tab_inactive"):
        if not filled.get(key):
            filled[key] = filled.get("background", PLAIN_BACKGROUND)
    return filled


def color_schemes():
    """scheme name -> normalized scheme dict, from settings or the builtins."""
    path = config_dir() / "settings.json"
    config = json.loads(path.read_text()) if path.exists() else {}
    schemes = config.get("workspace_color_schemes", None)
    if schemes is None:
        schemes = builtin_schemes()
    if not isinstance(schemes, list) or not schemes:
        raise ValueError("no color schemes available: set workspace_color_schemes "
                         "or keep niri-workspace-colors installed")
    out = {}
    for scheme in schemes:
        if not isinstance(scheme, dict) or not scheme.get("name"):
            raise ValueError("each scheme must be an object with a name")
        out[str(scheme["name"])] = normalize(scheme)
    return out


def read_color_assignments():
    """workspace id -> scheme name, from the color watcher's state file."""
    path = config_dir() / COLOR_STATE_NAME
    if not path.exists():
        return {}
    try:
        state = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return {str(k): v for k, v in state.get("assignments", {}).items()}


def scheme_for(ws, assignments, schemes):
    """The scheme a chip should render, or None for a machine-theme workspace.

    The watcher's own record for this workspace id wins; a workspace that
    merely bears a scheme name (a re-adopted one) falls back to the name.
    """
    ident = str(ws.get("id"))
    name = ws.get("name")
    managed = assignments.get(ident)
    if managed and managed in schemes:
        return schemes[managed]
    if name and name in schemes:
        return schemes[name]
    return None


def msg(*args):
    return subprocess.check_output(["niri", "msg", *args], text=True, timeout=3)


def sort_workspaces(live):
    """niri answers in creation order; chips must follow the on-screen
    numbering, which restarts at 1 on every monitor."""
    return sorted(live, key=lambda ws: (ws.get("output", ""), ws.get("idx", 0)))


def workspaces(request=msg):
    return sort_workspaces(json.loads(request("--json", "workspaces")))


def niri_outputs(request=msg):
    """output name -> {make, model, ...} for every connected display."""
    return json.loads(request("--json", "outputs"))


def group_by_output(live):
    """{output name: [workspaces by idx]} — the unit every strip renders."""
    groups = {}
    for ws in live:
        groups.setdefault(ws.get("output") or "unknown", []).append(ws)
    for group in groups.values():
        group.sort(key=lambda ws: ws.get("idx", 0))
    return groups


def focused_output(live):
    """The name of the monitor that currently holds the focus, or None."""
    for ws in live:
        if ws.get("is_focused"):
            return ws.get("output")
    return None


GEOMETRY_TOLERANCE = 4  # px; GDK rounds niri's fractional-scaled geometry by a step


def geometry_matches(logical, geometry):
    """Whether a niri output's logical rect is the same display as a GDK
    monitor's geometry. Niri and GDK compute logical size from the mode and
    fractional scale with slightly different rounding, so the rectangles
    agree up to a small step, never to the exact pixel."""
    if not logical or geometry is None:
        return False
    return (abs(logical.get("x", 0) - geometry.x) <= GEOMETRY_TOLERANCE
            and abs(logical.get("y", 0) - geometry.y) <= GEOMETRY_TOLERANCE
            and abs(logical.get("width", 0) - geometry.width) <= GEOMETRY_TOLERANCE
            and abs(logical.get("height", 0) - geometry.height) <= GEOMETRY_TOLERANCE)


def assign_monitors(outputs, monitors):
    """{niri output name: GdkMonitor} for any number and kind of screens.

    GTK 3 exposes no connector name on a monitor, so the mapping runs in
    three passes. (1) Layout geometry: niri reports each output's logical
    position and size and GDK reports the same screen layout, so this is
    exact and unambiguous — it distinguishes even two identical models
    sitting at different places in the layout. (2) EDID identity (make and
    model), taken one-to-one in name order, for screens whose geometry GDK
    reports differently than niri (fractional scaling, unusual rounding).
    (3) A leftover pair when one output and one monitor remain — the screen
    that reports no identity at all, unambiguous only while it is alone.
    Anything still unmapped is reported, never guessed at.
    """
    remaining = list(monitors)
    mapping = {}
    for name, info in outputs.items():
        for monitor in remaining:
            if geometry_matches(info.get("logical"), monitor.get_geometry()):
                mapping[name] = monitor
                remaining.remove(monitor)
                break
    for name in sorted(outputs):
        if name in mapping:
            continue
        info = outputs[name]
        for monitor in remaining:
            if (monitor.get_model() == info.get("model")
                    and monitor.get_manufacturer() == info.get("make")):
                mapping[name] = monitor
                remaining.remove(monitor)
                break
    unmapped = [name for name in outputs if name not in mapping]
    if len(unmapped) == 1 and len(remaining) == 1:
        mapping[unmapped[0]] = remaining[0]
    return mapping


def reorder_reference(group, idx):
    """The workspace a drag must move, looked up by its displayed index."""
    return next((ws for ws in group if ws.get("idx") == idx), None)


def cmd_status():
    enabled, _height, position, align, margin = settings()
    try:
        live = workspaces()
    except (OSError, subprocess.SubprocessError):
        raise SystemExit("workspace strip: niri is not reachable (NIRI_SOCKET?)")
    schemes = color_schemes()
    assignments = read_color_assignments()
    print("workspace strip: enabled" if enabled
          else "workspace strip: disabled (chips shown as the strip would draw them)")
    print(f"  position: {position}, align: {align}, margin: {margin}px "
          "(reserves space)")
    for output, group in group_by_output(live).items():
        print(f"  monitor {output}:")
        for ws in group:
            scheme = scheme_for(ws, assignments, schemes)
            label = ws.get("name") or "(unnamed)"
            state = scheme["name"] if scheme else "no scheme"
            focus = " *" if ws.get("is_focused") else ""
            print(f"    [{ws['idx']}] {label:<16} {state}{focus}")


def cmd_reorder(src_idx, dst_idx, output=None):
    settings()  # validate; reorder is usable with the toggle either way
    try:
        live = workspaces()
    except (OSError, subprocess.SubprocessError):
        raise SystemExit("workspace strip: niri is not reachable (NIRI_SOCKET?)")
    if output is None:
        candidates = [ws for ws in live if ws["idx"] == src_idx]
        if len(candidates) > 1:
            # Indexes repeat across monitors: only the focused monitor's
            # workspace is an unambiguous FROM.
            focused = focused_output(live)
            candidates = [ws for ws in candidates if ws.get("output") == focused]
        if not candidates:
            raise SystemExit(f"workspace strip: no workspace at index {src_idx} "
                             "on the focused monitor (name the monitor explicitly)")
        output = candidates[0]["output"]
    group = group_by_output(live).get(output, [])
    if reorder_reference(group, src_idx) is None:
        raise SystemExit(f"workspace strip: no workspace at index {src_idx} on {output}")
    if reorder_reference(group, dst_idx) is None:
        raise SystemExit(f"workspace strip: no workspace at index {dst_idx} on {output}")
    if src_idx == dst_idx:
        raise SystemExit("workspace strip: the workspace is already at that position")
    # Reorder actions resolve against the focused monitor, so aim the action
    # at the right screen first.
    msg("action", "focus-monitor", output)
    msg("action", "move-workspace-to-index", str(dst_idx), "--reference", str(src_idx))
    log(f"moved workspace {src_idx} to {dst_idx} on {output}")


def daemon(height, position, align, margin, schemes, assignments):
    try:
        import gi
    except ImportError:
        raise SystemExit("workspace strip: python3-gi is required "
                         "(python3-gi, gir1.2-gtk-3.0, gir1.2-gtklayershell-0.1)")
    try:
        gi.require_version("Gdk", "3.0")
        gi.require_version("Gtk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GLib, Gdk, Gtk, GtkLayerShell
    except (ValueError, ImportError) as error:
        raise SystemExit(f"workspace strip: GTK 3 + gtk-layer-shell are required ({error})")

    if not os.environ.get("WAYLAND_DISPLAY") or not os.environ.get("NIRI_SOCKET"):
        raise SystemExit("Run inside Niri: WAYLAND_DISPLAY and NIRI_SOCKET are required")

    # One strip daemon per seat, like the color watcher: the lock file is the
    # only thing that can tell two instances apart. It owns every per-monitor
    # window, so a single lock still covers the whole strip.
    runtime = os.environ["XDG_RUNTIME_DIR"]
    with open(os.path.join(runtime, LOCK_NAME), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("already running; quit the old strip before starting this version")
            return
        lock.seek(0)
        lock.truncate()
        lock.write(str(os.getpid()))
        lock.flush()
        run_daemon(height, position, align, margin, schemes, assignments,
                   GLib, Gdk, Gtk, GtkLayerShell)


def run_daemon(height, position, align, margin, schemes, assignments,
               GLib, Gdk, Gtk, GtkLayerShell):
    def on_term(_signum, _frame):
        Gtk.main_quit()
    signal.signal(signal.SIGTERM, on_term)

    provider = Gtk.CssProvider()
    # A provider attached to the window's own style context does not reach
    # the label children (their contexts never consult it) — on the screen
    # it covers the whole subtree, which is what the chip rules need. One
    # global provider serves every monitor window: the chip classes are
    # workspace ids, unique across the session.
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    manager = StripManager(height, position, align, margin, schemes, assignments,
                           GLib, Gdk, Gtk, GtkLayerShell, provider)

    stream = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                              stdout=subprocess.PIPE)
    fd = stream.stdout.fileno()
    os.set_blocking(fd, False)
    manager.stream_proc = stream
    manager.stream_fd = fd
    # The pygobject io_add_watch override takes a GLib.IOChannel (it asserts
    # on the type), so the non-blocking pipe fd is wrapped before watching;
    # reads still go through the raw fd in on_stream_data. The channel does
    # not take the fd from the pipe (close_on_unref stays off by default).
    channel = GLib.IOChannel.unix_new(fd)
    GLib.io_add_watch(channel, GLib.IOCondition.IN, manager.on_stream_data)

    # A plugged or unplugged screen changes the monitor list before (or
    # without) any workspace event: re-map the strips so a new window finds
    # its GdkMonitor and a dead one disappears even when niri is quiet. In
    # GTK 3 the hotplug signal is on the screen (GdkDisplay's monitor_added
    # /monitor_removed are the GTK 4 API); the screen still just routes to
    # the default display's monitor list.
    screen = Gdk.Screen.get_default()
    screen.connect("monitors-changed", lambda *_: manager.sync_monitors())

    manager.refresh(force=True)  # initial snapshot + windows + paint
    if not manager.strips:
        log("no monitors could be matched to niri outputs; "
            "workspaces are still listed by `status`")

    def force_commit():
        # gtk-layer-shell waits synchronously for the compositor's initial
        # configure while a window realizes. If that wait times out (busy
        # compositor at session start), show_all() returns with a configured
        # but never-presented surface: mapped, allocated, invisible. The
        # workaround is waybar's: once control is back in the main loop,
        # force every layer surface to commit its first buffer. (idle_add
        # invokes its callback with no arguments.)
        for strip in list(manager.strips.values()):
            strip.window.queue_resize()
            strip.window.queue_draw()
            GtkLayerShell.try_force_commit(strip.window)
        return False

    GLib.idle_add(force_commit)
    where = f"{position}, {align}, {margin}px margin"
    log(f"watching {height}px strips ({where}), one per monitor")
    Gtk.main()
    if stream.poll() is None:
        stream.terminate()
        try:
            stream.wait(timeout=2)
        except subprocess.TimeoutExpired:
            stream.kill()
        stream.wait()
        stream.stdout.close()


class StripManager:
    """Every per-monitor strip: the windows, the event stream, the hotplug."""

    def __init__(self, height, position, align, margin, schemes, assignments,
                 GLib, Gdk, Gtk, GtkLayerShell, provider):
        self.GLib = GLib
        self.Gdk = Gdk
        self.Gtk = Gtk
        self.GtkLayerShell = GtkLayerShell
        self.provider = provider
        self.height = height
        self.position = position
        self.align = align
        self.margin = margin
        self.schemes = schemes
        self.assignments = assignments
        self.strips = {}  # output name -> MonitorStrip
        self.snapshot = []
        self.stream_proc = None
        self.stream_fd = None
        self.stream_buffer = ""

    # -- windows ------------------------------------------------------------

    def create_strip(self, output, monitor):
        if monitor is None:
            return None
        Gtk, Gdk, GLib, GtkLayerShell = self.Gtk, self.Gdk, self.GLib, self.GtkLayerShell
        window = Gtk.Window()
        window.set_title("niri-workspace-strip")
        window.set_decorated(False)
        # The library wants init before the window is realized (waybar's own
        # source is explicit about this ordering), so it goes before any show.
        GtkLayerShell.init_for_window(window)
        # OVERLAY with margin 0: niri docks surfaces on the same edge in
        # layer order, so a higher layer lands inward of the lower layers'
        # exclusive zones — after waybar (TOP, exclusive) it docks at the
        # bar's bottom edge, and with no bar at all it falls back to the
        # screen edge. Both panels on TOP was a launch-order lottery (the
        # 0.6.0 overlap bug); the strip above the bar's zone is what
        # reserves space for windows. Keep the strip's margin at 0 so the
        # bar's own zone is not reserved twice.
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(window, "niri-workspace-strip")
        # One window per display: without this every strip would pile onto
        # the primary monitor and only that screen would show chips.
        GtkLayerShell.set_monitor(window, monitor)
        # A real exclusive zone (height + margin): the compositor docks the
        # strip like a bar, so waybar and the windows make room instead of
        # sitting under it. Overlapping panels proved a usability problem;
        # reserving space is the contract now.
        GtkLayerShell.set_exclusive_zone(window, self.height + self.margin)

        # All pointer logic lives on the event box, not on the chips: a
        # GtkButton child would swallow the press and the window would never
        # see the drag. Labels are windowless, so every event below is
        # delivered to this box instead. The mask is set explicitly rather
        # than relying on defaults: press/release and motion for the drag
        # (a seat grab keeps them coming outside the window too), and
        # leave-notify as the escape hatch when the grab could not be taken.
        area = Gtk.EventBox()
        area.set_visible_window(False)
        area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        area.add(box)
        window.add(area)
        window.set_can_focus(False)

        strip = MonitorStrip(output, window, area, box, self)
        area.connect("button-press-event", strip.on_press)
        area.connect("motion-notify-event", strip.on_motion)
        area.connect("button-release-event", strip.on_release)
        area.connect("leave-notify-event", strip.on_leave)
        window.connect(
            "configure-event",
            lambda _w, _e: (window.queue_draw(),
                            GtkLayerShell.try_force_commit(window), False)[-1])

        # Anchors come after the widgets exist: gtk-layer-shell derives the
        # layer surface size from the window allocation, and the anchored
        # edges decide where the surface may sit. For align=center nothing
        # is anchored horizontally — a layer surface with free horizontal
        # axes is centered by the compositor, and it keeps its natural
        # (chip-row) width instead of stretching between the edges.
        edge = GtkLayerShell.Edge.TOP if self.position == "top" else GtkLayerShell.Edge.BOTTOM
        GtkLayerShell.set_anchor(window, edge, True)
        if self.align == "left":
            GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.LEFT, True)
        elif self.align == "right":
            GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.RIGHT, True)
        if self.margin:
            GtkLayerShell.set_margin(window, edge, self.margin)

        strip.refresh([])  # empty row, correct surface size before the map
        window.show_all()
        GLib.idle_add(lambda: (window.queue_resize(), window.queue_draw(),
                               GtkLayerShell.try_force_commit(window), False)[-1])
        self.strips[output] = strip
        log(f"strip for monitor {output} ({monitor.get_model() or 'unknown'})")
        return strip

    def destroy_strip(self, output):
        strip = self.strips.pop(output, None)
        if strip is None:
            return
        strip.cancel_drag()
        strip.window.destroy()
        log(f"strip for monitor {output} is gone")

    # -- painting ---------------------------------------------------------

    def paint(self):
        """Load every strip's CSS as one blob: the provider is global, so the
        last writer would otherwise strip the other monitors' chip styles off."""
        blob = "\n".join(strip.css for strip in self.strips.values() if strip.css)
        self.provider.load_from_data(blob.encode("utf-8"))

    # -- data ---------------------------------------------------------------

    def refresh(self, force=False):
        if force or not self.snapshot:
            try:
                self.snapshot = workspaces()
            except (OSError, subprocess.SubprocessError):
                log("niri is not reachable right now; retrying on the next event")
                return
        self.assignments = read_color_assignments()
        self.sync_strips()

    def sync_strips(self):
        """Create, update and destroy strips so there is exactly one per
        monitor that currently holds workspaces. Unplugging a screen removes
        its group from the snapshot (niri moves its workspaces to a surviving
        monitor), and the surviving monitor's row simply re-renders — which
        is what collapsing the workspaces onto the other screen looks like."""
        groups = group_by_output(self.snapshot)
        for output in list(self.strips):
            if output not in groups:
                self.destroy_strip(output)
        if not groups:
            return
        for output, group in groups.items():
            strip = self.strips.get(output)
            if strip is None:
                strip = self.create_strip(output, self.monitor_for(output))
                if strip is None:
                    continue
            strip.refresh(group)

    def monitor_for(self, output):
        """The GdkMonitor for one niri output, or None while GDK has not
        finished enumerating it (a hotplug in flight). The whole output set
        is assigned together so identical monitors can never share one."""
        try:
            outputs = niri_outputs()
        except (OSError, subprocess.SubprocessError):
            return None
        if output not in outputs:
            return None
        # GTK 3 enumerates monitors by index on the display (GdkDisplay's
        # get_monitors iterator is the GTK 4 API and does not exist here).
        display = self.Gdk.Display.get_default()
        monitors = [display.get_monitor(i) for i in range(display.get_n_monitors())]
        monitor = assign_monitors(outputs, monitors).get(output)
        if monitor is None:
            log(f"cannot map monitor {output} to a GdkMonitor yet; "
                "the strip appears once the display is enumerated")
        return monitor

    def sync_monitors(self):
        """Gdk says the monitor list changed: a strip may now be mappable."""
        for output in group_by_output(self.snapshot):
            if output not in self.strips:
                monitor = self.monitor_for(output)
                if monitor is not None:
                    self.create_strip(output, monitor)

    # -- the niri event stream ----------------------------------------------

    def on_stream_data(self, _gstream, _condition):
        data = b""
        try:
            while True:
                chunk = os.read(self.stream_fd, 65536)
                if not chunk:
                    break
                data += chunk
        except BlockingIOError:
            pass
        except OSError:
            log("event stream died; restart the strip")
            self.Gtk.main_quit()
            return False
        if not data:
            log("niri event stream closed; restart the strip")
            self.Gtk.main_quit()
            return False
        self.stream_buffer += data.decode("utf-8", "replace")
        while "\n" in self.stream_buffer:
            line, self.stream_buffer = self.stream_buffer.split("\n", 1)
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if "WorkspacesChanged" in event:
                self.snapshot = sort_workspaces(event["WorkspacesChanged"]["workspaces"])
                self.refresh()
        return True


class MonitorStrip:
    """One monitor's row of chips: painting, hit testing, the drag in flight.

    All coordinates are computed from the known chip widths rather than from
    widget allocations: during a pointer grab events arrive with coordinates
    outside the window, and allocation queries there are unreliable — the
    arithmetic row is exact.
    """

    DRAG_THRESHOLD = 5  # px of motion before a press becomes a drag

    def __init__(self, output, window, area, box, manager):
        self.output = output
        self.window = window
        self.area = area
        self.box = box
        self.manager = manager
        self.group = []   # this monitor's workspaces, ordered by idx
        self.chips = []   # the labels currently packed
        self.slots = []   # (x0, x1, pos) of the rendered row
        self.css = ""     # this strip's share of the shared style provider
        self.drag = None  # {ws, x0, y0, moved, gap} while pressed
        self.grabbed = False

    # -- painting ---------------------------------------------------------

    def refresh(self, group):
        self.group = group
        self.rebuild()

    def row_layout(self):
        """The row to paint: the group, or the group minus the dragged chip
        with the open gap at its slot. Returns [(ws, is_gap)] of length
        len(group); the gap slot keeps the dragged workspace's identity so
        its chip visibly travels with the pointer."""
        if self.drag is None or not self.drag["moved"]:
            return [(ws, False) for ws in self.group]
        source = self.drag["ws"]
        others = [ws for ws in self.group if ws["id"] != source["id"]]
        row = []
        remaining = iter(others)
        for pos in range(len(self.group)):
            if pos == self.drag["gap"]:
                row.append((source, True))
            else:
                row.append((next(remaining), False))
        return row

    def width(self):
        n = len(self.group)
        if n == 0:
            return CHIP_WIDTH  # an empty row still reserves a legible strip
        total = n * CHIP_WIDTH
        if self.drag is not None and self.drag["moved"]:
            total += GAP_EXTRA
        return total

    def rebuild(self):
        for chip in self.chips:
            chip.destroy()
        self.chips = []
        css = [f"window {{ background-color: {PLAIN_BACKGROUND}; }}",
               "label { border: none; font-size: 13px; }"]
        self.slots = []
        x = 0
        for ws, is_gap in self.row_layout():
            chip_width = CHIP_WIDTH + GAP_EXTRA if is_gap else CHIP_WIDTH
            self.slots.append((x, x + chip_width, self.pos_of(ws)))
            x += chip_width
            chip = self.manager.Gtk.Label(label=str(ws["idx"]))
            chip.set_can_focus(False)
            # The chip box comes from the widget, not from CSS: a label's
            # CSS min-width/padding proved unreliable here, and a fixed
            # width is also what the surface resize below sizes against.
            chip.set_size_request(chip_width, self.manager.height)
            chip.set_xalign(0.5)
            chip.set_yalign(0.5)
            self.box.pack_start(chip, False, False, 0)
            self.chips.append(chip)
            ident = f"ws{ws['id']}"
            chip.get_style_context().add_class(ident)
            scheme = scheme_for(ws, self.manager.assignments, self.manager.schemes)
            background = scheme["background"] if scheme else PLAIN_BACKGROUND
            foreground = scheme["ring_active"] if scheme else PLAIN_FOREGROUND
            if is_gap:
                # The lifted chip: inverted colors on a wider slot, bordered
                # so the opening reads as the insertion point, not as a
                # differently colored workspace.
                accent = scheme["ring_active"] if scheme else PLAIN_ACCENT
                css.append(f"label.{ident} {{ background-color: {accent}; "
                           f"color: {DRAG_FOREGROUND}; "
                           f"border-top: 2px solid {accent}; "
                           f"border-bottom: 2px solid {accent}; }}")
                continue
            css.append(f"label.{ident} {{ background-color: {background}; "
                       f"color: {foreground}; }}")
            if ws.get("is_focused"):
                accent = scheme["ring_active"] if scheme else PLAIN_ACCENT
                css.append(f"label.{ident} {{ border-bottom: 2px solid {accent}; }}")
        self.css = "\n".join(css)
        self.box.show_all()
        # gtk-layer-shell has no explicit set_size in this version: the
        # library derives the layer surface size from the window's
        # allocation. Pushing the chip row's width into the window's size
        # request is therefore the one lever that resizes the surface, and
        # centering (no horizontal anchors) tracks it automatically as the
        # row grows and shrinks with the workspace count.
        self.window.set_size_request(max(self.width(), 1), self.manager.height)
        self.window.queue_resize()
        self.manager.paint()

    def pos_of(self, ws):
        """The 0-based slot this workspace occupies in the plain row."""
        return next(i for i, other in enumerate(self.group) if other["id"] == ws["id"])

    # -- hit testing (window-relative event coordinates, clamped) ----------

    def slot_at(self, x):
        if not self.slots:
            return None
        x = min(max(x, 0), self.slots[-1][1] - 1)
        for x0, x1, pos in self.slots:
            if x0 <= x < x1:
                return pos
        return self.slots[-1][2]

    # -- pointer events ----------------------------------------------------

    def on_press(self, _widget, event):
        pos = self.slot_at(event.x)
        log(f"press on {self.output}: x={event.x:.0f} slot={pos}")
        if pos is None or self.drag is not None:
            return False
        self.drag = {"ws": self.group[pos], "x0": event.x, "y0": event.y,
                     "moved": False, "gap": pos}
        return False

    def grab_pointer(self):
        """Own the pointer for the drag: without a grab, motion and release
        outside the strip's own window never arrive, and the drag died the
        moment the pointer left the chip row (the 0.5.0 failure)."""
        seat = self.manager.Gdk.Display.get_default().get_default_seat()
        if seat is None:
            return False
        try:
            error = seat.grab(self.window.get_window(),
                              self.manager.Gdk.SeatCapabilities.POINTER,
                              False, None, None, None)
        except Exception:  # noqa: BLE001 — any grab failure means no grab
            return False
        self.grabbed = error == self.manager.Gdk.GrabStatus.SUCCESS
        return self.grabbed

    def ungrab_pointer(self):
        if not self.grabbed:
            return
        self.grabbed = False
        seat = self.manager.Gdk.Display.get_default().get_default_seat()
        if seat is not None:
            try:
                seat.ungrab()
            except Exception:  # noqa: BLE001 — already gone: nothing to release
                pass

    def on_motion(self, _widget, event):
        if self.drag is None:
            return False
        if not self.drag["moved"]:
            if (abs(event.x - self.drag["x0"]) <= self.DRAG_THRESHOLD
                    and abs(event.y - self.drag["y0"]) <= self.DRAG_THRESHOLD):
                return False
            self.drag["moved"] = True
            self.grab_pointer()  # best effort; events keep flowing inside too
        gap = self.slot_at(event.x)
        if gap is not None and gap != self.drag["gap"]:
            self.drag["gap"] = gap
            self.rebuild()
        elif self.drag.get("rendered") is None:
            self.rebuild()  # first motion: draw the lifted chip at its slot
        self.drag["rendered"] = True
        return False

    def on_release(self, _widget, event):
        drag = self.drag
        self.drag = None
        self.ungrab_pointer()
        if drag is None:
            return False
        source = drag["ws"]
        if not drag["moved"]:
            # A plain click focuses the workspace. Indexes are per monitor,
            # so the monitor has to hold the focus first — an index action
            # resolves against the focused monitor. A nameless workspace is
            # addressed by index: focus-by-name is a no-op without a bearer.
            target = source["name"] if source.get("name") else str(source["idx"])
            log(f"click on {self.output}: focus-workspace {target!r}")
            try:
                self.focus_monitor()
                msg("action", "focus-workspace", target)
            except Exception as error:  # noqa: BLE001 — the strip must survive
                log(f"focus failed: {error}")
            self.manager.refresh(force=True)
            return False
        target_idx = drag["gap"] + 1  # 1-based, matching niri's display
        log(f"drag on {self.output}: {source['idx']} -> {target_idx}")
        if target_idx != source["idx"]:
            try:
                self.focus_monitor()
                msg("action", "move-workspace-to-index", str(target_idx),
                    "--reference", str(source["idx"]))
            except Exception as error:  # noqa: BLE001 — the strip must survive
                log(f"move failed: {error}")
        self.manager.refresh(force=True)
        self.rebuild()
        return False

    def on_leave(self, _widget, _event):
        # Without a grab, a pointer leaving the strip mid-drag means no
        # release will ever arrive: end the drag rather than leave a stuck
        # gap. With a grab, leaves are artifacts of the grab and must not
        # cancel anything — the release still arrives wherever it lands.
        if self.drag is not None and not self.grabbed:
            self.cancel_drag()
        return False

    def cancel_drag(self):
        had_drag = self.drag is not None
        self.drag = None
        self.ungrab_pointer()
        if had_drag:
            self.rebuild()

    def focus_monitor(self):
        focused = focused_output(self.manager.snapshot)
        if focused is not None and focused != self.output:
            msg("action", "focus-monitor", self.output)


def main():
    parser = argparse.ArgumentParser(description="niri workspace strip: drag-to-reorder numbered chips, one per monitor")
    parser.add_argument("--check", action="store_true",
                        help="validate settings without writes or IPC")
    parser.add_argument("command", nargs="?",
                        choices=["status", "reorder"],
                        help="one-shot command (otherwise: run the strips)")
    parser.add_argument("args", nargs="*",
                        help="for reorder: FROM TO [OUTPUT], the displayed indexes "
                             "and optionally the monitor name")
    args = parser.parse_args()
    try:
        enabled, height, position, align, margin = settings()
    except (OSError, ValueError, TypeError) as error:
        raise SystemExit(f"workspace strip: invalid settings: {error}") from error
    if args.check:
        if enabled:
            log(f"enabled, height {height}px, {position}/{align}, margin {margin}px "
                "(reserves space, one strip per monitor)")
        else:
            log("disabled (set workspace_strip true in settings.json)")
        try:
            import gi  # noqa: F401
            gi.require_version("Gtk", "3.0")
            gi.require_version("GtkLayerShell", "0.1")
            log("gtk layer-shell: available")
        except (ImportError, ValueError):
            log("gtk layer-shell: MISSING — the daemon will not start "
                "(python3-gi, gir1.2-gtk-3.0, gir1.2-gtklayershell-0.1)")
        return
    if not enabled and not args.command:
        # Same pattern as the color watcher: `niri-spaces start` launches the
        # helper regardless of the toggle, so a disabled strip ends quietly.
        # Explicit one-shot commands (status, reorder) answer regardless —
        # they are how a user inspects or moves workspaces by hand.
        log("disabled (set workspace_strip true in settings.json)")
        return
    if args.command == "status":
        cmd_status()
        return
    if args.command == "reorder":
        if len(args.args) not in (2, 3) or not all(a.isdigit() for a in args.args[:2]):
            raise SystemExit("usage: niri-workspace-strip reorder FROM TO [OUTPUT]")
        output = args.args[2] if len(args.args) == 3 else None
        cmd_reorder(int(args.args[0]), int(args.args[1]), output)
        return
    daemon(height, position, align, margin, color_schemes(), read_color_assignments())


if __name__ == "__main__":
    main()
