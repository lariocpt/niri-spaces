# Workspace 2 — terminal + browser
#
# Same pair as workspace 1 minus zenith; see spaces/main.space for how
# $TERMINAL / $BROWSER are resolved.
@workspace 2

# Left: plain terminal
$TERMINAL_APPID | $TERMINAL --title="ws2-terminal" | | term_id

# Right: browser
$BROWSER_APPID | $BROWSER | | browser_id

# 50/50 side by side
@action [ -n "${term_id:-}" ] && niri msg action focus-window --id "$term_id" && niri msg action set-column-width "50%"
@action [ -n "${browser_id:-}" ] && niri msg action focus-window --id "$browser_id" && niri msg action set-column-width "50%"
